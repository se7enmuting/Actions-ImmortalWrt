immortalwrt-*/** text eol=lf
.github/workflows/*.yml text eol=lf
README.md text eol=lf
LICENSE text eol=lf
.gitattributes text eol=lf

# Preserve nested upstream diff context, including its significant whitespace.
immortalwrt-25.12-fixed-25.12.2-20261105/patches/*.patch -whitespace

# Fixed geodata snapshots are binary, never normalize line endings.
immortalwrt-*/assets/*.mmdb -text

immortalwrt-*/assets/fallback-geodata/**/*.dat -text
immortalwrt-*/assets/fallback-geodata/**/*.mmdb -text
