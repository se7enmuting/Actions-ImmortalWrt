#!/bin/sh
# Fresh-image defaults only. No passwords, subscriptions, DNS tokens or site IPs.
uci -q batch <<'EOF'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
set luci.main.lang='zh_cn'
set luci.main.mediaurlbase='/luci-static/argon'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set bandix.general.iface='br-lan'
set bandix.general.host='127.0.0.1'
set bandix.traffic.enabled='1'
set bandix.traffic.traffic_realtime_window='600'
set bandix.traffic.traffic_enable_storage='1'
set bandix.traffic.traffic_flush_interval='600'
set bandix.connections.enabled='0'
set bandix.dns.enabled='0'
set nlbwmon.@nlbwmon[0].database_directory='/etc/nlbwmon'
set nlbwmon.@nlbwmon[0].commit_interval='1h'
set openclash.config.enable='0'
set openclash.config.core_type='Meta'
set openclash.config.core_version='linux-amd64-v2'
set dhcp.odhcpd.piodir='/etc/odhcpd-piodir'
set dhcp.lan.max_preferred_lifetime='2700'
set dhcp.lan.max_valid_lifetime='5400'
set passwall.@global[0].enabled='0'
set fwx.appfilter.enable='0'
set fwx.macfilter.enable='0'
set macfilter.global.enable='0'
set upnpd.config.enabled='0'
EOF
mkdir -p /etc/nlbwmon
mkdir -p /etc/odhcpd-piodir
chmod 700 /etc/odhcpd-piodir
for config in system luci firewall bandix nlbwmon openclash passwall fwx macfilter upnpd dhcp; do
    uci -q commit "$config"
done
# Monitor is available immediately; interception/filtering requires local setup.
for service in bandix nlbwmon qemu-ga; do
    [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" enable
done
for service in openclash passwall appfilter miniupnpd ddns acme; do
    [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" disable
done
# Native ACME installs its cron entry when started after local account setup.
[ ! -x /etc/init.d/acme ] || /etc/init.d/acme stop >/dev/null 2>&1
exit 0
